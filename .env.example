# Notion Integration
NOTION_API_KEY=PLACEHOLDER_REPLACE_WITH_YOUR_NOTION_TOKEN
NOTION_DATABASE_ID=PLACEHOLDER_REPLACE_WITH_YOUR_DATABASE_ID
NOTION_TEMPLATE_PAGE_ID=PLACEHOLDER_REPLACE_WITH_YOUR_TEMPLATE_ID

# Canva Integration
CANVA_API_KEY=PLACEHOLDER_REPLACE_WITH_YOUR_CANVA_KEY
CANVA_CLIENT_SECRET=PLACEHOLDER_REPLACE_WITH_YOUR_CLIENT_SECRET
CANVA_TEMPLATE_ID=PLACEHOLDER_REPLACE_WITH_YOUR_TEMPLATE_ID
CANVA_CLIENT_ID=PLACEHOLDER_REPLACE_WITH_YOUR_CLIENT_ID
CANVA_REDIRECT_URI=http://127.0.0.1:5001/oauth/canva/callback
# Used to sign the OAuth PKCE session cookie (set in production!)
FLASK_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING

# Optional: move imported Canva designs into a specific folder
# Example folder link: https://www.canva.com/folder/FAHAWSvTMQY -> folder id = FAHAWSvTMQY
CANVA_DESTINATION_FOLDER_ID=

# Optional: persist Canva tokens in Google Drive (recommended for production)
# CANVA_TOKEN_STORE_DRIVE_FILE_ID=
CANVA_TOKEN_STORE_DRIVE_FILE_NAME=canva_tokens.json
# If unset, defaults to GOOGLE_DRIVE_FOLDER_ID (if configured)
# CANVA_TOKEN_STORE_DRIVE_FOLDER_ID=

# DocSend Integration
DOCSEND_API_KEY=PLACEHOLDER_REPLACE_WITH_YOUR_DOCSEND_KEY
DOCSEND_INDIVIDUAL_DECK_ID=PLACEHOLDER_REPLACE_WITH_YOUR_DECK_ID
DOCSEND_MASTER_DECK_ID=PLACEHOLDER_REPLACE_WITH_YOUR_MASTER_DECK_ID

# Image Processing
REMOVEBG_API_KEY=PLACEHOLDER_REPLACE_WITH_YOUR_REMOVEBG_KEY

# LLM for Insights (Optional)
OPENAI_API_KEY=PLACEHOLDER_REPLACE_WITH_YOUR_OPENAI_KEY

# Granola (Future)
GRANOLA_API_KEY=PLACEHOLDER_REPLACE_WITH_YOUR_GRANOLA_KEY
